{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmv-creator.local/schema/pmv-project.schema.json",
  "title": "PMV Creator Project",
  "description": "Projektdatei (*.pmv.json) des Stash-Plugins PMV Creator. Alle Zeiten in Sekunden (float); auf Frames quantisiert wird erst beim Export/Render.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "output", "beatGrid", "sources", "bin", "exclusions", "tracks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },

    "output": { "$ref": "#/$defs/output" },
    "audio": {
      "description": "Musikspur. null = noch keine Musik gewählt.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/audio" }]
    },
    "beatGrid": { "$ref": "#/$defs/beatGrid" },

    "sources": {
      "description": "Snapshot der verwendeten Stash-Szenen (Schlüssel = Szenen-ID). Enthält nur, was der Renderer braucht – keine Stream-URLs/API-Keys.",
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "bin": {
      "description": "Vorauswahl (Culling): ausgewählte bzw. geschnipselte Segmente in der Reihenfolge der Seitenleiste.",
      "type": "array",
      "items": { "$ref": "#/$defs/snippet" }
    },
    "exclusions": {
      "description": "Bereiche, die nie im Schnitt landen sollen (ausgeschlossene Marker oder manuelle Bereiche).",
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "tracks": {
      "description": "Videospuren. tracks[0] ist die oberste Spur und gewinnt bei Überlappung.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "markers": {
      "description": "Timeline-Marker (z. B. Drop, Refrain).",
      "type": "array",
      "items": { "$ref": "#/$defs/timelineMarker" }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "stashId": { "type": "string", "pattern": "^[0-9]+$" },
    "seconds": { "type": "number", "minimum": 0 },

    "output": {
      "type": "object",
      "required": ["width", "height", "fps", "fit", "videoCodec", "crf", "preset", "audioBitrate"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 7680, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4320, "multipleOf": 2 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120, "description": "Ausgabe-Framerate; 23.976/29.97/59.94 werden als NTSC-Raten gerendert." },
        "fit": { "$ref": "#/$defs/fit" },
        "videoCodec": { "enum": ["libx264", "libx265", "h264_nvenc", "hevc_nvenc"] },
        "crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "preset": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "audioBitrate": { "type": "string", "pattern": "^[0-9]+k$" }
      }
    },

    "fit": { "enum": ["cover", "contain", "blur"], "description": "cover = crop to the frame, contain = letterbox/pillarbox, blur = whole picture over a blurred, filled copy of itself." },

    "audio": {
      "type": "object",
      "required": ["name", "path", "url", "duration", "sourceIn", "start", "gainDb", "fadeIn", "fadeOut"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": ["string", "null"], "description": "Pfad auf dem Stash-Server – wird vom Renderer verwendet." },
        "url": { "type": ["string", "null"], "description": "URL (relativ zur Stash-Basis-URL) für Waveform und Browser-Vorschau." },
        "duration": { "$ref": "#/$defs/seconds", "description": "Länge der Audiodatei." },
        "sourceIn": { "$ref": "#/$defs/seconds", "description": "Startpunkt innerhalb der Audiodatei." },
        "start": { "$ref": "#/$defs/seconds", "description": "Position von sourceIn auf der Timeline." },
        "gainDb": { "type": "number", "minimum": -60, "maximum": 24 },
        "fadeIn": { "$ref": "#/$defs/seconds" },
        "fadeOut": { "$ref": "#/$defs/seconds", "description": "Fade-out am Ende der Ausgabe." }
      }
    },

    "beatGrid": {
      "type": "object",
      "required": ["bpm", "offset", "beatsPerBar"],
      "additionalProperties": false,
      "properties": {
        "bpm": { "type": "number", "minimum": 20, "maximum": 300 },
        "offset": { "$ref": "#/$defs/seconds", "description": "Timeline-Zeit eines beliebigen Beats (Anker des Rasters)." },
        "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },

    "source": {
      "type": "object",
      "required": ["sceneId", "path", "title", "duration", "fps", "width", "height", "hasAudio"],
      "additionalProperties": false,
      "properties": {
        "sceneId": { "$ref": "#/$defs/stashId" },
        "fileId": { "type": ["string", "null"] },
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "duration": { "$ref": "#/$defs/seconds" },
        "fps": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "hasAudio": { "type": "boolean" },
        "videoCodec": { "type": ["string", "null"] }
      }
    },

    "snippet": {
      "type": "object",
      "required": ["id", "sceneId", "markerId", "in", "out", "label", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/stashId" },
        "markerId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stashId" }] },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" },
        "label": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },

    "exclusion": {
      "type": "object",
      "required": ["id", "sceneId", "markerId", "in", "out"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/stashId" },
        "markerId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stashId" }] },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" }
      }
    },

    "transition": {
      "type": "object",
      "required": ["type", "duration"],
      "additionalProperties": false,
      "description": "Übergang in diesen Clip hinein, zentriert auf den Schnitt (nutzt Handles der Nachbarclips).",
      "properties": {
        "type": {
          "enum": ["fade", "fadeblack", "fadewhite", "dissolve", "wipeleft", "wiperight", "slideleft", "slideright", "circleopen", "pixelize", "zoomin", "hblur", "radial"],
          "description": "Entspricht den FFmpeg-xfade-Transitions."
        },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
      }
    },

    "clip": {
      "type": "object",
      "required": ["id", "sceneId", "snippetId", "markerId", "start", "duration", "sourceIn", "speed", "volume", "transitionIn", "fit", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/stashId" },
        "snippetId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "markerId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stashId" }] },
        "start": { "$ref": "#/$defs/seconds", "description": "In-Point auf der Timeline." },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "Clip-Dauer auf der Timeline. Out-Point der Quelle = sourceIn + duration * speed." },
        "sourceIn": { "$ref": "#/$defs/seconds", "description": "In-Point in der Quelle." },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "Abspielgeschwindigkeit (1 = normal)." },
        "volume": { "type": "number", "minimum": 0, "maximum": 2, "description": "Lautstärke des Original-Tons (0 = nur Musik)." },
        "transitionIn": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transition" }] },
        "fit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fit" }], "description": "null = output.fit" },
        "label": { "type": "string" }
      }
    },

    "track": {
      "type": "object",
      "required": ["id", "name", "muted", "locked", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "muted": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "clips": {
          "type": "array",
          "description": "Nach start sortiert, ohne Überlappung innerhalb der Spur.",
          "items": { "$ref": "#/$defs/clip" }
        }
      }
    },

    "timelineMarker": {
      "type": "object",
      "required": ["id", "time", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "time": { "$ref": "#/$defs/seconds" },
        "label": { "type": "string" }
      }
    }
  }
}
