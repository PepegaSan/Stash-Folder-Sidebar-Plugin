{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmv-creator.local/schema/pmv-project.schema.json",
  "title": "PMV Creator Project",
  "description": "Projektdatei (*.pmv.json) des Stash-Plugins PMV Creator. Alle Zeiten in Sekunden (float); auf Frames quantisiert wird erst beim Export/Render.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "output", "beatGrid", "sources", "bin", "exclusions", "tracks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },

    "output": { "$ref": "#/$defs/output" },
    "effects": { "$ref": "#/$defs/effects" },
    "layouts": {
      "description": "Split-Screens: Bereiche der Timeline, in denen mehrere Clips gleichzeitig zu sehen sind. Feld-Gruppe 0 zeigt die unterste Spur (V1), Gruppe 1 die darüber usw.",
      "type": "array",
      "items": { "$ref": "#/$defs/layout" }
    },
    "audio": {
      "description": "Musikspur. null = noch keine Musik gewählt.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/audio" }]
    },
    "beatGrid": { "$ref": "#/$defs/beatGrid" },

    "sources": {
      "description": "Snapshot der verwendeten Stash-Szenen (Schlüssel = Szenen-ID). Enthält nur, was der Renderer braucht – keine Stream-URLs/API-Keys.",
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "bin": {
      "description": "Vorauswahl (Culling): ausgewählte bzw. geschnipselte Segmente in der Reihenfolge der Seitenleiste.",
      "type": "array",
      "items": { "$ref": "#/$defs/snippet" }
    },
    "exclusions": {
      "description": "Bereiche, die nie im Schnitt landen sollen (ausgeschlossene Marker oder manuelle Bereiche).",
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "tracks": {
      "description": "Videospuren. tracks[0] ist die oberste Spur und gewinnt bei Überlappung.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "markers": {
      "description": "Timeline-Marker (z. B. Drop, Refrain).",
      "type": "array",
      "items": { "$ref": "#/$defs/timelineMarker" }
    },
    "generator": {
      "description": "Letzter Generator-Lauf (Einstellungen und Bereich) – damit lässt sich ein einzelner Clip später mit denselben Regeln neu würfeln. Fehlt bzw. null bei nie generierten Projekten.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["settings", "from", "to"],
          "properties": {
            "settings": { "type": "object" },
            "from": { "$ref": "#/$defs/seconds" },
            "to": { "$ref": "#/$defs/seconds" }
          }
        }
      ]
    },
    "cutTemplate": {
      "description": "Ein anderes PMV, dessen Schnitte der Generator übernehmen kann (Zeiten in dessen eigener Zeit). music = Name der Projektmusik, wenn es dessen Ton ist.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["sceneId", "title", "duration", "cuts", "flashes", "music"],
          "properties": {
            "sceneId": { "$ref": "#/$defs/stashId" },
            "title": { "type": "string" },
            "duration": { "$ref": "#/$defs/seconds" },
            "cuts": { "type": "array", "items": { "$ref": "#/$defs/seconds" } },
            "flashes": { "type": "array", "items": { "$ref": "#/$defs/seconds" } },
            "music": { "type": ["string", "null"] }
          }
        }
      ]
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "stashId": { "type": "string", "pattern": "^[0-9]+$" },
    "seconds": { "type": "number", "minimum": 0 },

    "output": {
      "type": "object",
      "required": ["width", "height", "fps", "fit", "videoCodec", "crf", "preset", "audioBitrate"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 7680, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4320, "multipleOf": 2 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120, "description": "Ausgabe-Framerate; 23.976/29.97/59.94 werden als NTSC-Raten gerendert." },
        "fit": { "$ref": "#/$defs/fit" },
        "videoCodec": { "enum": ["libx264", "libx265", "h264_nvenc", "hevc_nvenc"] },
        "crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "preset": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "audioBitrate": { "type": "string", "pattern": "^[0-9]+k$" },
        "look": { "enum": ["none", "warm", "pink", "cold", "vivid", "bw", "noir", "custom"], "description": "Farb-Look des ganzen PMV (wie im PMV Generator)." },
        "lookAmount": { "type": "number", "minimum": 0, "maximum": 1, "description": "Stärke des Looks." },
        "lookColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Tönung des Looks „eigene Farbe“." },
        "brightness": { "type": "number", "minimum": 0, "maximum": 1, "description": "Zusätzliche Helligkeit (weich, ohne die Lichter auszubrennen)." }
      }
    },

    "effects": {
      "description": "Beat- und Drop-Effekte des ganzen PMV (wie im PMV Generator). Wann sie feuern, ergibt sich aus Beat-Raster und Lautheit der Musik.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoom": { "type": "boolean", "description": "Zoom-Puls im Beat." },
        "shake": { "type": "boolean", "description": "Wackeln auf lauten Beats." },
        "stutter": { "type": "boolean", "description": "Stottern: in lauten Teilen springt der Clip auf jedem zweiten halben Beat zurück." },
        "strobe": { "type": "boolean", "description": "Weiße Blitze auf halben Beats in lauten Teilen." },
        "rgb": { "type": "boolean", "description": "RGB-Split auf Drops, lauten Takten und Schnitten." },
        "glitch": { "type": "boolean", "description": "Verrutschende Bildstreifen auf Drops und sehr lauten Takten." },
        "tunnel": { "type": "boolean", "description": "Tunnel auf Drops." },
        "invert": { "type": "boolean", "description": "Kurzes Negativ auf Drops." },
        "echo": { "type": "boolean", "description": "Geisterbilder in lauten Teilen." },
        "text": { "type": "boolean", "description": "Wörter (words) auf Drops und manchen lauten Takten." },
        "hue": { "type": "boolean", "description": "Farbrausch: die Farben drehen sich durch den Song." },
        "flash": { "type": "boolean", "description": "Blitz, wo ein Split-Screen beginnt oder endet (rosa auf einem Drop)." },
        "lines": { "type": "boolean", "description": "Die Trennlinien eines Split-Screens leuchten auf jedem Beat." },
        "pulseAmount": { "type": "number", "minimum": 0, "maximum": 1.5, "description": "Stärke des Zoom-Pulses (1 = wie im PMV Generator)." },
        "pulseOn": { "enum": ["beat", "2", "bar"], "description": "Zoom-Puls auf jedem Beat, auf Beat 1 und 3 oder auf jedem Takt (Drops immer)." },
        "words": { "type": "string", "maxLength": 2000, "description": "Wörter für den Text-Effekt, durch Kommas getrennt." }
      }
    },

    "layout": {
      "type": "object",
      "required": ["id", "start", "duration", "kind", "dir"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "start": { "$ref": "#/$defs/seconds" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "kind": { "enum": ["duo", "trim", "tri", "quad", "kaleido"], "description": "2 nebeneinander, 3 gespiegelt (außen derselbe Clip), 3, 4 Felder, Kaleidoskop (ein Clip, vierfach gespiegelt)." },
        "dir": { "enum": ["cols", "rows"], "description": "Felder nebeneinander oder übereinander (4 Felder und Kaleidoskop: Raster)." }
      }
    },

    "fit": { "enum": ["cover", "contain", "blur"], "description": "cover = crop to the frame, contain = letterbox/pillarbox, blur = whole picture over a blurred, filled copy of itself." },

    "audio": {
      "type": "object",
      "required": ["name", "path", "url", "duration", "sourceIn", "start", "gainDb", "fadeIn", "fadeOut"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": ["string", "null"], "description": "Pfad auf dem Stash-Server – wird vom Renderer verwendet." },
        "url": { "type": ["string", "null"], "description": "URL (relativ zur Stash-Basis-URL) für Waveform und Browser-Vorschau." },
        "duration": { "$ref": "#/$defs/seconds", "description": "Länge der Audiodatei." },
        "sourceIn": { "$ref": "#/$defs/seconds", "description": "Startpunkt innerhalb der Audiodatei." },
        "start": { "$ref": "#/$defs/seconds", "description": "Position von sourceIn auf der Timeline." },
        "gainDb": { "type": "number", "minimum": -60, "maximum": 24 },
        "fadeIn": { "$ref": "#/$defs/seconds" },
        "fadeOut": { "$ref": "#/$defs/seconds", "description": "Fade-out am Ende der Ausgabe." }
      }
    },

    "beatGrid": {
      "type": "object",
      "required": ["bpm", "offset", "beatsPerBar"],
      "additionalProperties": false,
      "properties": {
        "bpm": { "type": "number", "minimum": 20, "maximum": 300 },
        "offset": { "$ref": "#/$defs/seconds", "description": "Timeline-Zeit eines beliebigen Beats (Anker des Rasters)." },
        "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },

    "source": {
      "type": "object",
      "required": ["sceneId", "path", "title", "duration", "fps", "width", "height", "hasAudio"],
      "additionalProperties": false,
      "properties": {
        "sceneId": { "$ref": "#/$defs/stashId" },
        "fileId": { "type": ["string", "null"] },
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "duration": { "$ref": "#/$defs/seconds" },
        "fps": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "hasAudio": { "type": "boolean" },
        "videoCodec": { "type": ["string", "null"] }
      }
    },

    "snippet": {
      "type": "object",
      "required": ["id", "sceneId", "markerId", "in", "out", "label", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/stashId" },
        "markerId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stashId" }] },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" },
        "label": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },

    "exclusion": {
      "type": "object",
      "required": ["id", "sceneId", "markerId", "in", "out"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/stashId" },
        "markerId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stashId" }] },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" }
      }
    },

    "transition": {
      "type": "object",
      "required": ["type", "duration"],
      "additionalProperties": false,
      "description": "Übergang in diesen Clip hinein, zentriert auf den Schnitt (nutzt Handles der Nachbarclips).",
      "properties": {
        "type": {
          "enum": ["fade", "fadeblack", "fadewhite", "dissolve", "wipeleft", "wiperight", "slideleft", "slideright", "circleopen", "pixelize", "zoomin", "hblur", "radial"],
          "description": "Entspricht den FFmpeg-xfade-Transitions."
        },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
      }
    },

    "clip": {
      "type": "object",
      "required": ["id", "sceneId", "snippetId", "markerId", "start", "duration", "sourceIn", "speed", "volume", "transitionIn", "fit", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/stashId" },
        "snippetId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "markerId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stashId" }] },
        "start": { "$ref": "#/$defs/seconds", "description": "In-Point auf der Timeline." },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "Clip-Dauer auf der Timeline. Out-Point der Quelle = sourceIn + duration * speed." },
        "sourceIn": { "$ref": "#/$defs/seconds", "description": "In-Point in der Quelle." },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "Abspielgeschwindigkeit (1 = normal)." },
        "volume": { "type": "number", "minimum": 0, "maximum": 2, "description": "Lautstärke des Original-Tons (0 = nur Musik)." },
        "transitionIn": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transition" }] },
        "fit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fit" }], "description": "null = output.fit" },
        "label": { "type": "string" },
        "pinned": { "type": "boolean", "description": "Vom Generator festgehalten: erneutes Erzeugen lässt den Clip stehen." }
      }
    },

    "track": {
      "type": "object",
      "required": ["id", "name", "muted", "locked", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "muted": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "clips": {
          "type": "array",
          "description": "Nach start sortiert, ohne Überlappung innerhalb der Spur.",
          "items": { "$ref": "#/$defs/clip" }
        }
      }
    },

    "timelineMarker": {
      "type": "object",
      "required": ["id", "time", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "time": { "$ref": "#/$defs/seconds" },
        "label": { "type": "string" }
      }
    }
  }
}
